PORT=5001
CLIENT_URL=http://localhost:5174
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/ledgerline
REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
COOKIE_SAMESITE=lax

# Optional: plain-English explanations written by a language model.
# "mock" builds the explanation from the rule results, with no API key.
EXPLAIN_PROVIDER=mock        # anthropic | openai | mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_CHAT_MODEL=gpt-4o-mini
